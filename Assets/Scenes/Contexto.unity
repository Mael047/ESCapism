  fadeOutAmbiente: 1.5
  beats:
  - nombre: "ESCENA 1: Mundo m\xE1gico"
    frases:
    - "Cuando cae la noche, te conviertes en chica m\xE1gica."
    - La academia brilla bajo las estrellas, tus amigas te esperan en la entrada
    - y cada monstruo que derrotas hace que el mundo entero te aplauda.
    aparicion: 0
    fuente: {fileID: 11400000, guid: 0467aee5e7df0a0498e004f40a47b85c, type: 2}
    color: {r: 1, g: 0.72, b: 0.88, a: 1}
    tamano: 46
    fadeFrase: 1.1
    letrasPorSegundo: 30
    pausaEntreFrases: 0.8
    silencioAntes: 0
    mantener: 1.2
    fadeSalida: 0.5
    flash: 0
    colorFlash: {r: 1, g: 1, b: 1, a: 1}
    temblor: 0
    zoomFinal: 1
    duracionZoom: 8
    glitchEnSegundo: -1
    pulso: 0
    fondo: {fileID: 0}
    musica: {fileID: 8300000, guid: 4970926129edb90409ef9a2ec80d2400, type: 3}
    detenerMusica: 0
    pitchMusica: 1
    ambiente: {fileID: 8300000, guid: 709d04cc2940b1245a8cacafcca2dc89, type: 3}
    detenerAmbiente: 0
    sfx: {fileID: 0}
  - nombre: 'CORTE A: Amanece'
    frases:
    - Amanece.
    aparicion: 2
    fuente: {fileID: 0}
    color: {r: 1, g: 1, b: 1, a: 1}
    tamano: 64
    fadeFrase: 1
    letrasPorSegundo: 30
    pausaEntreFrases: 0.8
    silencioAntes: 0
    mantener: 1
    fadeSalida: 0.1
    flash: 1
    colorFlash: {r: 1, g: 1, b: 1, a: 1}
    temblor: 0
    zoomFinal: 1
    duracionZoom: 8
    glitchEnSegundo: -1
    pulso: 0
    fondo: {fileID: 0}
    musica: {fileID: 8300000, guid: bf9800c77e1b8db449d0103a26653954, type: 3}
    detenerMusica: 1
    pitchMusica: 1
    ambiente: {fileID: 0}
    detenerAmbiente: 1
    sfx: {fileID: 0}
  - nombre: 'ESCENA 2: Realidad'
    frases:
    - "Pero el sol sale, y con \xE9l vuelve todo lo dem\xE1s."
    - "Turnos interminables detr\xE1s de una caja, clientes que ni te miran, cuentas que no cuadran."
    - "Aqu\xED nadie te aplaude."
    - "Nadie nota si est\xE1s cansada."
    aparicion: 1
    fuente: {fileID: 0}
    color: {r: 0.75, g: 0.78, b: 0.8, a: 1}
    tamano: 38
    fadeFrase: 1
    letrasPorSegundo: 32
    pausaEntreFrases: 0.5
    silencioAntes: 0
    mantener: 1
    fadeSalida: 0.5
