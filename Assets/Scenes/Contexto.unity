    detenerAmbiente: 0
    sfx: {fileID: 8300000, guid: c349bf013c9f6604a90630af68685466, type: 3}
  - nombre: 'CORTE B: Llega la noche'
    frases:
    - Pero llega la noche.
    aparicion: 0
    fuente: {fileID: 11400000, guid: 0467aee5e7df0a0498e004f40a47b85c, type: 2}
